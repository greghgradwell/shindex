# Database Configuration
# Copy this file to .env and update with your actual values
# DO NOT commit .env to git (it's already in .gitignore)
#
# Note: DB_NAME should include the environment suffix
# For dev: inventory_locator_dev
# For test: inventory_locator (test suffix added automatically)

DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_NAME=inventory_locator_dev
