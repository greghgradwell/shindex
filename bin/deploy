#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.." || exit 1

if [[ ! -f .envrc ]]; then
  echo "ERROR: .envrc not found." >&2
  exit 1
fi

source .envrc

echo "==> Pulling latest code..."
git pull origin main

echo "==> Installing production dependencies..."
MIX_ENV=prod mix deps.get --only prod

echo "==> Building assets..."
MIX_ENV=prod mix assets.deploy

echo "==> Building release..."
MIX_ENV=prod mix release --overwrite

echo "==> Linking persistent upload directories..."
RELEASE_STATIC=$(ls -d _build/prod/rel/inventory_locator/lib/inventory_locator-*/priv/static 2>/dev/null | head -1)
mkdir -p "$HOME/inventory-uploads" "$HOME/inventory-documents"
rm -rf "$RELEASE_STATIC/uploads" "$RELEASE_STATIC/documents"
ln -s "$HOME/inventory-uploads" "$RELEASE_STATIC/uploads"
ln -s "$HOME/inventory-documents" "$RELEASE_STATIC/documents"

echo "==> Running migrations..."
PHX_SERVER=false _build/prod/rel/inventory_locator/bin/inventory_locator eval "InventoryLocator.Release.migrate()"

echo "==> Restarting service..."
sudo systemctl restart shindex

echo "==> Done."
