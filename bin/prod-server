#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.." || exit 1

if [[ ! -f .envrc ]]; then
  echo "ERROR: .envrc not found. Copy deploy/.envrc.example and configure it." >&2
  exit 1
fi

required_vars=(DATABASE_URL SECRET_KEY_BASE PHX_HOST)

for var in "${required_vars[@]}"; do
  unset "$var"
done

source .envrc

for var in "${required_vars[@]}"; do
  if [[ -z "${!var:-}" ]]; then
    echo "ERROR: Required variable $var is not set in .envrc" >&2
    exit 1
  fi
done

export PHX_SERVER=true
exec _build/prod/rel/inventory_locator/bin/inventory_locator start
