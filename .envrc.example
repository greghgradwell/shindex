# Development environment variables
# Copy this file to .envrc and update with your actual values
# DO NOT commit .envrc to git (it's already in .gitignore)
#
# Setup instructions:
# 1. Install direnv: https://direnv.net/docs/installation.html
# 2. Add to your shell config (~/.zshrc or ~/.bashrc):
#    eval "$(direnv hook zsh)"  # or bash
# 3. Reload your shell: source ~/.zshrc
# 4. Copy this file: cp .envrc.example .envrc
# 5. Update values in .envrc
# 6. Allow direnv: direnv allow
#
# After setup, direnv automatically loads these when you cd into the project

export DB_USERNAME=your_db_username
export DB_PASSWORD=your_db_password
export DB_HOST=localhost
export DB_NAME=inventory_locator_dev
export SECRET_KEY_BASE=your_secret_key
export GEMINI_API_KEY=your_secret_key
export TAVILY_API_KEY=your_secret_key


# OAuth Authentication (optional - sign-in buttons still show but will fail gracefully)
# GitHub: https://github.com/settings/developers → New OAuth App
#   Homepage URL: http://localhost:4000
#   Callback URL: http://localhost:4000/auth/github/callback
# export GITHUB_CLIENT_ID=your_github_client_id
# export GITHUB_CLIENT_SECRET=your_github_client_secret

# LinkedIn: https://www.linkedin.com/developers/apps → Create App
#   Redirect URL: http://localhost:4000/auth/linkedin/callback
# export LINKEDIN_CLIENT_ID=your_linkedin_client_id
# export LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# GCS Backup Configuration (optional - backups disabled if not set)
# export GCS_BACKUP_BUCKET=your-backup-bucket-name
# export GCS_SERVICE_ACCOUNT_JSON=/path/to/service-account.json