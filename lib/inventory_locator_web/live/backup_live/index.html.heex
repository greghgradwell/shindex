<div class="space-y-6">
  <div class="flex justify-between items-center">
    <h1 class="text-2xl font-bold">Backups</h1>

    <%= if @configured do %>
      <div class="dropdown dropdown-end">
        <div tabindex="0" role="button" class="btn btn-primary" disabled={@backup_running}>
          <%= if @backup_running do %>
            <span class="loading loading-spinner loading-sm"></span> Running...
          <% else %>
            Run Backup
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="size-4"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
            </svg>
          <% end %>
        </div>
        <ul
          tabindex="0"
          class="dropdown-content z-[1] menu p-2 shadow bg-base-100 rounded-box w-52"
        >
          <li><button phx-click="run_backup" phx-value-type="daily">Daily Backup</button></li>
          <li><button phx-click="run_backup" phx-value-type="weekly">Weekly Backup</button></li>
        </ul>
      </div>
    <% end %>
  </div>
  
<!-- Tabs -->
  <div role="tablist" class="tabs tabs-boxed">
    <button
      role="tab"
      class={"tab #{if @active_tab == :daily, do: "tab-active"}"}
      phx-click="switch_tab"
      phx-value-tab="daily"
    >
      Daily
    </button>
    <button
      role="tab"
      class={"tab #{if @active_tab == :weekly, do: "tab-active"}"}
      phx-click="switch_tab"
      phx-value-tab="weekly"
    >
      Weekly
    </button>
    <button
      role="tab"
      class={"tab #{if @active_tab == :settings, do: "tab-active"}"}
      phx-click="switch_tab"
      phx-value-tab="settings"
    >
      Settings
    </button>
  </div>
  
<!-- Tab Content -->
  <%= if @active_tab == :daily do %>
    <.backup_list backups={@daily_backups} type="daily" configured={@configured} />
  <% end %>

  <%= if @active_tab == :weekly do %>
    <.backup_list backups={@weekly_backups} type="weekly" configured={@configured} />
  <% end %>

  <%= if @active_tab == :settings do %>
    <.settings_form changeset={@settings_changeset} settings={@settings} configured={@configured} />
  <% end %>
</div>

<!-- Restore Confirmation Modal -->
<%= if @restore_modal_open do %>
  <div class="modal modal-open">
    <div class="modal-box">
      <h3 class="font-bold text-lg flex items-center gap-2 text-warning">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-6 w-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
          />
        </svg>
        Restore Database
      </h3>

      <div class="py-4 space-y-4">
        <p>You are about to restore the database to:</p>
        <p class="font-mono bg-base-200 p-2 rounded">
          {InventoryLocator.Backup.extract_timestamp_from_key(@restore_target)}
        </p>

        <div class="alert alert-warning">
          <div>
            <p class="font-semibold">⚠️ WARNING: This will:</p>
            <ul class="list-disc list-inside text-sm mt-1">
              <li>Put the app in maintenance mode</li>
              <li>Replace ALL current data with the backup</li>
              <li>This action cannot be undone</li>
            </ul>
          </div>
        </div>

        <p class="text-sm">A backup of the current database will be created first.</p>

        <div class="form-control">
          <label class="label">
            <span class="label-text">
              Type "{expected_confirmation(@restore_target)}" to confirm:
            </span>
          </label>
          <input
            type="text"
            class="input input-bordered"
            phx-keyup="update_restore_confirmation"
            value={@restore_confirmation}
            autocomplete="off"
          />
        </div>
      </div>

      <div class="modal-action">
        <button class="btn" phx-click="close_restore_modal">Cancel</button>
        <button
          class="btn btn-warning"
          phx-click="confirm_restore"
          disabled={@restore_confirmation != expected_confirmation(@restore_target)}
        >
          Restore Database
        </button>
      </div>
    </div>
    <div class="modal-backdrop" phx-click="close_restore_modal"></div>
  </div>
<% end %>

<!-- Delete Confirmation Modal -->
<%= if @delete_modal_open do %>
  <div class="modal modal-open">
    <div class="modal-box">
      <h3 class="font-bold text-lg flex items-center gap-2 text-error">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-6 w-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
          />
        </svg>
        Delete Backup
      </h3>

      <div class="py-4 space-y-4">
        <p>Are you sure you want to delete this backup?</p>
        <p class="font-mono bg-base-200 p-2 rounded">
          {InventoryLocator.Backup.extract_timestamp_from_key(@delete_target)}
        </p>

        <div class="alert alert-error">
          <div>
            <p class="font-semibold">This action cannot be undone.</p>
          </div>
        </div>
      </div>

      <div class="modal-action">
        <button class="btn" phx-click="close_delete_modal">Cancel</button>
        <button class="btn btn-error" phx-click="confirm_delete">
          Delete Backup
        </button>
      </div>
    </div>
    <div class="modal-backdrop" phx-click="close_delete_modal"></div>
  </div>
<% end %>

<!-- Maintenance Mode Overlay -->
<%= if @maintenance_state.active do %>
  <div class="fixed inset-0 z-50 bg-base-300/80 flex items-center justify-center">
    <div class="card bg-base-100 shadow-xl p-8 text-center">
      <div class="flex flex-col items-center gap-4">
        <span class="loading loading-spinner loading-lg text-primary"></span>
        <h2 class="text-xl font-bold">🔧 Maintenance Mode</h2>
        <p>{@maintenance_state.reason}</p>
        <p class="text-sm text-base-content/60">Please wait...</p>
      </div>
    </div>
  </div>
<% end %>
