<.header>
  Location Management
</.header>

<div class="mt-8 space-y-6">
  <%= for shelf <- @shelves do %>
    <.shelf_row shelf={shelf} />
  <% end %>
</div>

<.live_component
  :if={@selected_item_id}
  module={InventoryLocatorWeb.ItemLive.ShowModal}
  id="item-show-modal"
  item_id={@selected_item_id}
/>
