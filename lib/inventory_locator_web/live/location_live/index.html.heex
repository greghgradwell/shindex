<.header>
  Location Management
  <:actions>
    <.button phx-click="show_create_shelf_modal">
      <.icon name="hero-plus" class="w-4 h-4 mr-1" /> Create Shelf
    </.button>
  </:actions>
</.header>

<div class="mt-4 space-y-6">
  <%= if @shelves == [] do %>
    <div class="text-center py-12 text-base-content/60">
      <.icon name="hero-archive-box" class="w-12 h-12 mx-auto mb-4 opacity-50" />
      <p class="text-lg">No shelves yet</p>
      <p class="text-sm mt-2">Create your first shelf to start organizing your inventory.</p>
    </div>
  <% else %>
    <%= for shelf <- @shelves do %>
      <.shelf_row shelf={shelf} />
    <% end %>
  <% end %>
</div>

<%!-- Create Shelf Modal --%>
<div
  :if={@show_create_shelf_modal}
  class="modal modal-open"
  phx-window-keydown="close_create_shelf_modal"
  phx-key="escape"
>
  <div class="modal-box" phx-click-away="close_create_shelf_modal">
    <h3 class="font-bold text-lg mb-4">Create New Shelf</h3>

    <form phx-submit="create_shelf" phx-change="validate_shelf_code" autocomplete="off">
      <div class="form-control mb-4">
        <label class="label">
          <span class="label-text">Shelf Code</span>
        </label>
        <input
          type="text"
          name="code"
          id="create-shelf-code-input"
          placeholder="e.g., A, TOOLS, PARTS"
          class={["input input-bordered w-full uppercase", @shelf_code_error && "input-error"]}
          required
          phx-mounted={JS.focus()}
        />
        <label :if={@shelf_code_error} class="label">
          <span class="label-text-alt text-error">{@shelf_code_error}</span>
        </label>
        <label :if={!@shelf_code_error} class="label">
          <span class="label-text-alt">
            Must start with a letter (letters, numbers, underscores allowed)
          </span>
        </label>
      </div>

      <div class="form-control mb-4">
        <label class="label">
          <span class="label-text">Number of Bins</span>
        </label>
        <select name="bin_count" class="select select-bordered w-full">
          <%= for n <- 1..20 do %>
            <option value={n} selected={n == 1}>{n}</option>
          <% end %>
        </select>
        <label class="label">
          <span class="label-text-alt">Each bin gets a location (e.g., A-1, A-2)</span>
        </label>
      </div>

      <div class="modal-action">
        <button type="button" class="btn btn-ghost" phx-click="close_create_shelf_modal">
          Cancel
        </button>
        <button type="submit" class="btn btn-primary" disabled={@shelf_code_error != nil}>
          Create Shelf
        </button>
      </div>
    </form>
  </div>
</div>

<%!-- Rename Shelf Modal --%>
<div
  :if={@show_rename_shelf_modal}
  class="modal modal-open"
  phx-window-keydown="close_rename_shelf_modal"
  phx-key="escape"
>
  <div class="modal-box" phx-click-away="close_rename_shelf_modal">
    <h3 class="font-bold text-lg mb-4">Rename Shelf</h3>

    <form phx-submit="rename_shelf" phx-change="validate_shelf_code" autocomplete="off">
      <div class="form-control mb-4">
        <label class="label">
          <span class="label-text">Current Code</span>
        </label>
        <input
          type="text"
          value={@rename_shelf && @rename_shelf.code}
          class="input input-bordered w-full"
          disabled
        />
      </div>

      <div class="form-control mb-4">
        <label class="label">
          <span class="label-text">New Code</span>
        </label>
        <input
          type="text"
          name="new_code"
          id="rename-shelf-code-input"
          value={@rename_shelf && @rename_shelf.code}
          placeholder="e.g., A, TOOLS"
          class={["input input-bordered w-full uppercase", @shelf_code_error && "input-error"]}
          required
          phx-mounted={JS.focus()}
        />
        <label :if={@shelf_code_error} class="label">
          <span class="label-text-alt text-error">{@shelf_code_error}</span>
        </label>
      </div>

      <%= if @rename_shelf_location_count > 0 do %>
        <div class="alert alert-warning mb-4">
          <.icon name="hero-exclamation-triangle" />
          <span>This will update {@rename_shelf_location_count} location code(s)</span>
        </div>
      <% end %>

      <div class="modal-action">
        <button type="button" class="btn btn-ghost" phx-click="close_rename_shelf_modal">
          Cancel
        </button>
        <button type="submit" class="btn btn-primary" disabled={@shelf_code_error != nil}>
          Save Changes
        </button>
      </div>
    </form>
  </div>
</div>

<%!-- Move Bin Modal --%>
<div
  :if={@show_rename_bin_modal}
  class="modal modal-open"
  phx-window-keydown="close_rename_bin_modal"
  phx-key="escape"
>
  <div class="modal-box" phx-click-away="close_rename_bin_modal">
    <h3 class="font-bold text-lg mb-4">Move Bin</h3>

    <form phx-submit="move_bin" phx-change="validate_bin_move" autocomplete="off">
      <div class="form-control mb-4">
        <label class="label">
          <span class="label-text">Current Location</span>
        </label>
        <input
          type="text"
          value={@rename_bin && "#{@rename_bin_shelf.code}-#{@rename_bin.code}"}
          class="input input-bordered w-full"
          disabled
        />
      </div>

      <div class="form-control mb-4">
        <label class="label">
          <span class="label-text">New Location</span>
        </label>
        <div class="flex items-center gap-2">
          <select name="target_shelf_id" class="select select-bordered">
            <%= for shelf <- @all_shelves do %>
              <option value={shelf.id} selected={shelf.id == @rename_bin_shelf.id}>
                {shelf.code}
              </option>
            <% end %>
          </select>
          <span class="text-lg font-medium">-</span>
          <input
            type="text"
            name="new_code"
            id="rename-bin-code-input"
            value={@rename_bin && @rename_bin.code}
            placeholder="e.g., 1, 2, 3"
            class={["input input-bordered w-24", @bin_code_error && "input-error"]}
            required
            phx-mounted={JS.focus()}
          />
        </div>
        <label :if={@bin_code_error} class="label">
          <span class="label-text-alt text-error">{@bin_code_error}</span>
        </label>
        <label :if={!@bin_code_error} class="label">
          <span class="label-text-alt">
            Select shelf and enter bin number (1-999)
          </span>
        </label>
      </div>

      <div class="modal-action">
        <button type="button" class="btn btn-ghost" phx-click="close_rename_bin_modal">
          Cancel
        </button>
        <button type="submit" class="btn btn-primary" disabled={@bin_code_error != nil}>
          Move Bin
        </button>
      </div>
    </form>
  </div>
</div>

<.live_component
  :if={@selected_item_id}
  module={InventoryLocatorWeb.ItemLive.ShowModal}
  id="item-show-modal"
  item_id={@selected_item_id}
  current_inventory={@current_inventory}
/>
