<div>
  <div
    class="modal modal-open"
    phx-window-keydown="close_modal"
    phx-key="escape"
    phx-target={@myself}
  >
    <div
      class="modal-box max-w-5xl max-h-[90vh] overflow-y-auto relative"
      phx-click-away="close_modal"
      phx-target={@myself}
    >
      <button
        type="button"
        phx-click="close_modal"
        phx-target={@myself}
        class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2"
      >
        ✕
      </button>

      <div class="pr-8">
        <h2 class="text-2xl font-bold">{@item.name}</h2>
        <p class="text-sm text-base-content/60">
          <%= if @item.archived do %>
            <span class="inline-block px-2 py-1 bg-gray-200 text-gray-700 text-xs rounded">
              Archived
            </span>
          <% else %>
            {if @item.location, do: @item.location.full_code, else: "No location"}
          <% end %>
        </p>
      </div>

      <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Photo Section -->
        <%!-- Form wrapper required for LiveComponent uploads - routes events to component --%>
        <form id="photo-upload-form" phx-change="photo_selected" phx-target={@myself}>
          <%!-- File input: positioned off-screen so it can't intercept clicks but still receives label events --%>
          <.live_file_input upload={@uploads.photo} class="absolute -top-[9999px] -left-[9999px]" />

          <%!-- Edit Mode: Show upload preview or current photo with change button --%>
          <%= if @editing do %>
            <%!-- Show preview of new photo if selected --%>
            <%= for entry <- @uploads.photo.entries do %>
              <div class="relative">
                <.live_img_preview
                  entry={entry}
                  class="w-full h-80 object-cover rounded-lg shadow-lg"
                />
                <button
                  type="button"
                  phx-click="cancel_photo_upload"
                  phx-target={@myself}
                  class="absolute top-2 right-2 btn btn-circle btn-sm btn-error"
                >
                  ✕
                </button>
                <%!-- Progress bar --%>
                <div :if={entry.progress < 100} class="absolute bottom-0 left-0 right-0 p-2">
                  <progress
                    class="progress progress-primary w-full"
                    value={entry.progress}
                    max="100"
                  />
                </div>
              </div>
              <%!-- Upload errors --%>
              <%= for err <- upload_errors(@uploads.photo, entry) do %>
                <p class="text-error text-sm mt-2">{upload_error_to_string(err)}</p>
              <% end %>
            <% end %>

            <%!-- Show current photo or placeholder with "Change Photo" button when no pending upload --%>
            <div :if={@uploads.photo.entries == []} class="relative">
              <%= if @item.photo_path do %>
                <img
                  src={"/uploads/#{@item.photo_path}"}
                  alt={@item.name}
                  class="w-full h-80 object-cover rounded-lg shadow-lg"
                />
              <% else %>
                <div class="w-full h-80 bg-gray-200 rounded-lg flex items-center justify-center">
                  <.icon name="hero-photo" class="w-20 h-20 text-gray-400" />
                </div>
              <% end %>
              <label
                for={@uploads.photo.ref}
                class="absolute bottom-4 left-1/2 -translate-x-1/2 btn btn-primary btn-sm cursor-pointer shadow-lg"
              >
                📷 {if @item.photo_path, do: "Change Photo", else: "Add Photo"}
              </label>
            </div>
          <% else %>
            <%!-- View Mode --%>
            <%= if @uploads.photo.entries != [] do %>
              <%!-- Upload in progress: show preview with Save/Cancel --%>
              <%= for entry <- @uploads.photo.entries do %>
                <div class="relative">
                  <.live_img_preview
                    entry={entry}
                    class="w-full h-80 object-cover rounded-lg shadow-lg"
                  />
                  <%!-- Progress bar --%>
                  <div :if={entry.progress < 100} class="absolute bottom-0 left-0 right-0 p-2">
                    <progress
                      class="progress progress-primary w-full"
                      value={entry.progress}
                      max="100"
                    />
                  </div>
                  <%!-- Save/Cancel buttons after upload completes --%>
                  <div
                    :if={entry.progress == 100}
                    class="absolute bottom-4 left-1/2 -translate-x-1/2 flex gap-2"
                  >
                    <button
                      type="button"
                      phx-click="save_photo_only"
                      phx-target={@myself}
                      class="btn btn-primary btn-sm shadow-lg"
                    >
                      ✓ Save
                    </button>
                    <button
                      type="button"
                      phx-click="cancel_photo_upload"
                      phx-target={@myself}
                      class="btn btn-ghost btn-sm bg-base-100/80 shadow-lg"
                    >
                      ✕ Cancel
                    </button>
                  </div>
                </div>
                <%!-- Upload errors --%>
                <%= for err <- upload_errors(@uploads.photo, entry) do %>
                  <p class="text-error text-sm mt-2">{upload_error_to_string(err)}</p>
                <% end %>
              <% end %>
            <% else %>
              <%!-- No upload in progress --%>
              <%= if @item.photo_path do %>
                <%!-- Has photo: just show it --%>
                <img
                  src={"/uploads/#{@item.photo_path}"}
                  alt={@item.name}
                  class="w-full h-80 object-cover rounded-lg shadow-lg"
                />
              <% else %>
                <%!-- No photo: show placeholder with Select Photo button --%>
                <div class="relative">
                  <div class="w-full h-80 bg-gray-200 rounded-lg flex items-center justify-center">
                    <.icon name="hero-photo" class="w-20 h-20 text-gray-400" />
                  </div>
                  <div class="absolute bottom-4 left-0 right-0 flex justify-center">
                    <label
                      for={@uploads.photo.ref}
                      class="btn btn-primary btn-sm cursor-pointer shadow-lg"
                    >
                      📷 Select Photo
                    </label>
                  </div>
                </div>
              <% end %>
            <% end %>
          <% end %>
        </form>
        
<!-- Details Section -->
        <div class="space-y-4">
          <!-- Metadata -->
          <div class="border rounded-lg p-4">
            <div class="flex justify-between items-center mb-4">
              <h3 class="text-lg font-semibold">Details</h3>
              <%= if not @editing do %>
                <button phx-click="toggle_edit" phx-target={@myself} class="btn btn-sm btn-ghost">
                  <.icon name="hero-pencil" class="w-4 h-4" /> Edit
                </button>
              <% end %>
            </div>

            <%= if @editing do %>
              <div id="edit-form-container">
                <.form
                  :let={f}
                  for={@edit_changeset}
                  id="item-details-form"
                  phx-submit="update_item_details"
                  phx-target={@myself}
                  autocomplete="off"
                >
                  <.input field={f[:name]} type="text" label="Name" value={@item.name} required />
                  <.input
                    field={f[:manufacturer]}
                    type="text"
                    label="Manufacturer"
                    value={@item.manufacturer}
                  />
                  <.input field={f[:model]} type="text" label="Model" value={@item.model} />
                  <.input
                    field={f[:description]}
                    type="text"
                    label="Description"
                    value={@item.description}
                  />

                  <div class="flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary btn-sm">Save</button>
                    <button
                      type="button"
                      phx-click="cancel_edit"
                      phx-target={@myself}
                      class="btn btn-ghost btn-sm"
                    >
                      Cancel
                    </button>
                  </div>
                </.form>
              </div>
            <% else %>
              <div id="view-mode-container">
                <.list>
                  <:item title="Location">
                    <div class="flex items-center justify-between gap-2">
                      <span>
                        {if @item.location,
                          do: @item.location.full_code,
                          else: "No location (archived)"}
                      </span>
                      <%= if not @item.archived do %>
                        <button
                          phx-click="toggle_move"
                          phx-target={@myself}
                          class="btn btn-xs btn-ghost"
                        >
                          <.icon name="hero-arrow-right-circle" class="w-4 h-4" /> Move
                        </button>
                      <% end %>
                    </div>
                  </:item>
                  <:item title="Name">{@item.name}</:item>
                  <:item :if={@item.manufacturer} title="Manufacturer">
                    {@item.manufacturer}
                  </:item>
                  <:item :if={@item.model} title="Model">{@item.model}</:item>
                  <:item :if={@item.description} title="Description">{@item.description}</:item>
                </.list>

                <%= if @moving do %>
                  <div class="mt-4 p-4 border border-info rounded-lg bg-info/5">
                    <h4 class="font-semibold text-sm mb-3">Move to New Location</h4>
                    <.form
                      :let={f}
                      for={%{}}
                      id="move-location-form"
                      phx-submit="move_to_location"
                      phx-change="validate_move_location"
                      phx-target={@myself}
                      autocomplete="off"
                    >
                      <.ghost_autocomplete
                        id="move-location-input"
                        name={f[:location_code].name}
                        label="New Location Code"
                        placeholder="e.g., A-1-1"
                        value=""
                        suggestions={@location_codes}
                        required
                        autofocus
                      />

                      <%= if @move_location_warning do %>
                        <div class="alert alert-warning mt-2">
                          <.icon name="hero-exclamation-triangle" />
                          <span>
                            Location {@move_location_warning.code} has {@move_location_warning.count} active item(s).
                            Item will be co-located.
                          </span>
                        </div>
                      <% end %>

                      <div class="flex gap-2 mt-3">
                        <button type="submit" class="btn btn-sm btn-primary">Move</button>
                        <button
                          type="button"
                          phx-click="cancel_move"
                          phx-target={@myself}
                          class="btn btn-sm btn-ghost"
                        >
                          Cancel
                        </button>
                      </div>
                    </.form>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
          
<!-- Quantity Controls -->
          <%= if not @item.archived do %>
            <div class="border rounded-lg p-4">
              <div class="flex justify-between items-center mb-4">
                <h3 class="text-lg font-semibold">In Stock</h3>
                <%= if @installed_quantity > 0 do %>
                  <span class="text-sm text-base-content/60">
                    {@installed_quantity} installed in projects
                  </span>
                <% end %>
              </div>
              <div class="flex items-center justify-center gap-4">
                <button
                  phx-click="decrement_quantity"
                  phx-target={@myself}
                  class="btn btn-circle btn-md"
                >
                  <.icon name="hero-minus-circle" class="w-6 h-6" />
                </button>
                <form
                  id="quantity-update-form"
                  phx-change="update_quantity"
                  phx-target={@myself}
                  class="flex-shrink-0"
                  autocomplete="off"
                >
                  <input
                    type="number"
                    name="quantity"
                    value={@item.quantity}
                    class="input input-bordered w-20 text-center text-xl font-bold"
                    min="0"
                  />
                </form>
                <button
                  phx-click="increment_quantity"
                  phx-target={@myself}
                  class="btn btn-circle btn-md"
                >
                  <.icon name="hero-plus-circle" class="w-6 h-6" />
                </button>
              </div>
            </div>
          <% end %>
          
<!-- Installations -->
          <div class="border rounded-lg p-4">
            <div class="flex justify-between items-center mb-4">
              <h3 class="text-lg font-semibold">Installed In</h3>
              <%= if not @item.archived and @item.quantity > 0 and not @installing do %>
                <button
                  phx-click="toggle_install"
                  phx-target={@myself}
                  class="btn btn-sm btn-ghost"
                >
                  <.icon name="hero-plus" class="w-4 h-4" /> Install
                </button>
              <% end %>
            </div>

            <%= if @installing do %>
              <div class="p-4 border border-info rounded-lg bg-info/5 mb-4">
                <h4 class="font-semibold text-sm mb-3">Install in Project</h4>
                <.form
                  :let={f}
                  for={%{}}
                  id="install-item-form"
                  phx-submit="install_item"
                  phx-target={@myself}
                  autocomplete="off"
                >
                  <.ghost_autocomplete
                    id="install-project-input"
                    name={f[:project_name].name}
                    label="Project Name"
                    placeholder="e.g., ROBOT_ARM"
                    value=""
                    suggestions={@project_names}
                    required
                    autofocus
                  />

                  <.input
                    field={f[:quantity]}
                    type="number"
                    label="Quantity"
                    value="1"
                    min="1"
                    max={@item.quantity}
                    required
                  />

                  <p class="text-xs text-base-content/60 mt-1">
                    {@item.quantity} in stock
                  </p>

                  <div class="flex gap-2 mt-3">
                    <button type="submit" class="btn btn-sm btn-primary">Install</button>
                    <button
                      type="button"
                      phx-click="cancel_install"
                      phx-target={@myself}
                      class="btn btn-sm btn-ghost"
                    >
                      Cancel
                    </button>
                  </div>
                </.form>
              </div>
            <% end %>

            <%= if @installations == [] do %>
              <p class="text-sm text-base-content/60">Not installed in any projects</p>
            <% else %>
              <ul class="space-y-2">
                <%= for installation <- @installations do %>
                  <li class="flex items-center justify-between p-2 bg-base-200 rounded">
                    <span class="font-mono text-sm">
                      {installation.project_name}
                      <span class="text-base-content/60">({installation.quantity})</span>
                    </span>
                    <div class="flex items-center gap-1">
                      <button
                        phx-click="decrement_installation"
                        phx-value-installation_id={installation.id}
                        phx-target={@myself}
                        class="btn btn-xs btn-ghost font-bold"
                        title="Remove one"
                      >
                        −
                      </button>
                      <%= if not @item.archived and @item.quantity > 0 do %>
                        <button
                          phx-click="increment_installation"
                          phx-value-installation_id={installation.id}
                          phx-target={@myself}
                          class="btn btn-xs btn-ghost text-success font-bold"
                          title="Add one more"
                        >
                          +
                        </button>
                      <% end %>
                      <button
                        phx-click="uninstall_item"
                        phx-value-installation_id={installation.id}
                        phx-target={@myself}
                        class="btn btn-xs btn-ghost text-error"
                        title="Remove all"
                      >
                        <.icon name="hero-x-mark" class="w-4 h-4" />
                      </button>
                    </div>
                  </li>
                <% end %>
              </ul>
            <% end %>
          </div>
          
<!-- Archive/Restore Section -->
          <%= if not @item.archived do %>
            <div class="border-t pt-4">
              <.button
                phx-click="archive"
                phx-target={@myself}
                data-confirm="Archive this item? Its location will be freed for reuse and the item quantity will be set to 0."
                class="w-full btn btn-outline btn-warning btn-sm"
              >
                Archive Item
              </.button>
            </div>
          <% else %>
            <div class="border-t pt-4">
              <.button phx-click="show_restore_modal" phx-target={@myself} class="w-full btn-sm">
                Restore Item
              </.button>
              <p class="mt-2 text-sm text-gray-600">
                Restore this item by assigning a new location and quantity.
              </p>
            </div>
          <% end %>
          
<!-- Delete Section -->
          <div class="border-t pt-4">
            <button
              type="button"
              phx-click="show_delete_modal"
              phx-target={@myself}
              class="btn btn-outline btn-error btn-sm w-full"
            >
              🗑️ Delete Permanently
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
  
<!-- Restore Modal (nested) -->
  <div
    :if={@show_restore_modal}
    class="modal modal-open"
    style="z-index: 1000;"
    phx-window-keydown="close_restore_modal"
    phx-key="escape"
    phx-target={@myself}
  >
    <div class="modal-box" phx-click-away="close_restore_modal" phx-target={@myself}>
      <h3 class="font-bold text-lg">Restore Item</h3>
      <p class="py-4 text-sm text-gray-600">
        <%= if @pending_restore_quantity do %>
          Choose a location for the {@pending_restore_quantity} item(s) returned from the project.
        <% else %>
          Assign a new location and quantity to restore this item.
        <% end %>
      </p>

      <.form
        :let={f}
        for={%{}}
        id="restore-item-form"
        phx-submit="restore"
        phx-change="validate_location"
        phx-target={@myself}
        autocomplete="off"
      >
        <.ghost_autocomplete
          id="restore-location-input"
          name={f[:location_code].name}
          label="Location Code"
          placeholder="e.g., A-1-1"
          suggestions={@location_codes}
          required
          autofocus
        />

        <%= if @location_warning do %>
          <div class="alert alert-warning mt-2">
            <.icon name="hero-exclamation-triangle" />
            <span>
              Location {@location_warning.code} has {@location_warning.count} active item(s).
              Item will be co-located.
            </span>
          </div>
        <% end %>

        <.input
          field={f[:quantity]}
          type="number"
          label="Quantity"
          value={@pending_restore_quantity || 1}
          min="1"
          required
        />

        <div class="modal-action">
          <button
            type="button"
            class="btn btn-ghost"
            phx-click="close_restore_modal"
            phx-target={@myself}
          >
            Cancel
          </button>
          <button type="submit" class="btn btn-primary">
            Restore
          </button>
        </div>
      </.form>
    </div>
  </div>
  
<!-- Archive from Quantity Modal (nested) -->
  <div
    :if={@show_archive_quantity_modal}
    class="modal modal-open"
    style="z-index: 1000;"
    phx-window-keydown="cancel_archive_from_quantity"
    phx-key="escape"
    phx-target={@myself}
  >
    <div class="modal-box" phx-click-away="cancel_archive_from_quantity" phx-target={@myself}>
      <h3 class="font-bold text-lg">Archive Item?</h3>
      <p class="py-4 text-sm text-gray-600">
        Setting quantity to 0 will archive this item. Its location will be freed for reuse.
      </p>

      <div class="modal-action">
        <button
          type="button"
          class="btn btn-ghost"
          phx-click="cancel_archive_from_quantity"
          phx-target={@myself}
        >
          Cancel
        </button>
        <button
          type="button"
          class="btn btn-error"
          phx-click="confirm_archive_from_quantity"
          phx-target={@myself}
        >
          Archive Item
        </button>
      </div>
    </div>
  </div>
  
<!-- Delete Confirmation Modal (nested) -->
  <div
    :if={@show_delete_modal}
    class="modal modal-open"
    style="z-index: 1000;"
    phx-window-keydown="hide_delete_modal"
    phx-key="escape"
    phx-target={@myself}
  >
    <div class="modal-box">
      <h3 class="font-bold text-lg text-error">Delete Item Permanently?</h3>
      <p class="py-4">
        Are you sure you want to permanently delete <strong>{@item.name}</strong>?
        This will remove the item from the database and cannot be undone.
      </p>

      <div class="modal-action">
        <button
          type="button"
          class="btn btn-ghost"
          phx-click="hide_delete_modal"
          phx-target={@myself}
        >
          Cancel
        </button>
        <button
          type="button"
          class="btn btn-error"
          phx-click="delete"
          phx-target={@myself}
        >
          🗑️ Delete Forever
        </button>
      </div>
    </div>
    <div class="modal-backdrop bg-black/50" phx-click="hide_delete_modal" phx-target={@myself}>
    </div>
  </div>
</div>
