<div>
  <div
    class="modal modal-open"
    phx-window-keydown="close_modal"
    phx-key="escape"
    phx-target={@myself}
  >
    <div
      class="modal-box max-w-5xl max-h-[90vh] overflow-y-auto relative"
      phx-click-away="close_modal"
      phx-target={@myself}
    >
      <button
        type="button"
        phx-click="close_modal"
        phx-target={@myself}
        class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2"
      >
        ✕
      </button>

      <div class="pr-8">
        <div :if={@batch_mode} class="text-sm text-primary font-medium mb-1">
          Editing incomplete item ({@batch_total} remaining)
        </div>
        <h2 class="text-2xl font-bold">{@item.name}</h2>
        <p class="text-sm text-base-content/60">
          <%= if @item.archived do %>
            <span class="inline-block px-2 py-1 bg-gray-200 text-gray-700 text-xs rounded">
              Archived
            </span>
          <% else %>
            {if @item.location, do: @item.location.full_code, else: "No location"}
          <% end %>
        </p>
      </div>

      <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <%!-- Edit Mode: Show PhotoCapture component --%>
          <%= if @editing do %>
            <.live_component
              module={InventoryLocatorWeb.Components.PhotoCapture}
              id="modal-photo-capture"
              current_photo_path={@item.photo_path}
              size={:compact}
            />
          <% else %>
            <%!-- View Mode: Show current photo or pending photo with Save/Cancel --%>
            <%= if @pending_photo do %>
              <%!-- Pending photo ready: show preview with Save/Cancel --%>
              <div class="relative">
                <img
                  src={@pending_photo.data_uri}
                  alt="New photo"
                  class="w-full h-80 object-cover rounded-lg shadow-lg"
                />
                <div class="absolute bottom-4 left-1/2 -translate-x-1/2 flex gap-2">
                  <button
                    type="button"
                    phx-click="save_photo_only"
                    phx-target={@myself}
                    class="btn btn-primary btn-sm shadow-lg"
                  >
                    ✓ Save
                  </button>
                  <button
                    type="button"
                    phx-click="cancel_pending_photo"
                    phx-target={@myself}
                    class="btn btn-ghost btn-sm bg-base-100/80 shadow-lg"
                  >
                    ✕ Cancel
                  </button>
                </div>
              </div>
            <% else %>
              <%!-- No pending photo --%>
              <%= if @item.photo_path do %>
                <div class="space-y-4">
                  <img
                    src={"/uploads/#{@item.photo_path}"}
                    alt={@item.name}
                    class="w-full h-80 object-cover rounded-lg shadow-lg"
                  />
                  <%= if @inventory_role == :owner do %>
                    <.live_component
                      module={InventoryLocatorWeb.Components.PhotoCapture}
                      id="modal-photo-capture"
                      size={:compact}
                    />
                  <% end %>
                </div>
              <% else %>
                <%= if @inventory_role == :owner do %>
                  <.live_component
                    module={InventoryLocatorWeb.Components.PhotoCapture}
                    id="modal-photo-capture"
                    size={:compact}
                  />
                <% else %>
                  <div class="w-full h-80 bg-base-200 rounded-lg flex items-center justify-center">
                    <span class="text-base-content/40 text-sm">No photo</span>
                  </div>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        </div>

        <div class="space-y-4">
          <div class="border rounded-lg p-4">
            <div class="flex justify-between items-center mb-4">
              <h3 class="text-lg font-semibold">Details</h3>
              <%= if not @editing and @inventory_role == :owner do %>
                <button phx-click="toggle_edit" phx-target={@myself} class="btn btn-sm btn-ghost">
                  <.icon name="hero-pencil" class="w-4 h-4" /> Edit
                </button>
              <% end %>
            </div>

            <%= if @editing do %>
              <div id={"edit-form-container-#{@item.id}"} phx-hook="FocusFirstEmpty">
                <.form
                  :let={f}
                  for={@edit_changeset}
                  id={"item-details-form-#{@item.id}"}
                  phx-change="validate_item_details"
                  phx-submit="update_item_details"
                  phx-target={@myself}
                  autocomplete="off"
                >
                  <.input field={f[:name]} type="text" label="Name" phx-debounce="blur" required />
                  <.input
                    field={f[:manufacturer]}
                    type="text"
                    label="Manufacturer"
                    phx-debounce="blur"
                  />
                  <.input
                    field={f[:model]}
                    type="text"
                    label="Model / Part #"
                    phx-debounce="blur"
                  />
                  <.input
                    field={f[:description]}
                    type="text"
                    label="Description"
                    phx-debounce="blur"
                  />
                  <.input
                    field={f[:source_url]}
                    type="url"
                    label="Product URL"
                    placeholder="https://manufacturer.com/product"
                    phx-debounce="blur"
                  />

                  <div class="flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary btn-sm">
                      {if @batch_mode, do: "Save & Next", else: "Save"}
                    </button>
                    <button
                      type="button"
                      phx-click="cancel_edit"
                      phx-target={@myself}
                      class="btn btn-ghost btn-sm"
                    >
                      Cancel
                    </button>
                  </div>
                </.form>
              </div>
            <% else %>
              <div id="view-mode-container">
                <.list>
                  <:item title="Location">
                    <div class="flex items-center justify-between gap-2">
                      <span>
                        {if @item.location,
                          do: @item.location.full_code,
                          else: "No location (archived)"}
                      </span>
                      <%= if not @item.archived and @inventory_role == :owner do %>
                        <button
                          phx-click="toggle_move"
                          phx-target={@myself}
                          class="btn btn-xs btn-ghost"
                        >
                          <.icon name="hero-arrow-right-circle" class="w-4 h-4" /> Move
                        </button>
                      <% end %>
                    </div>
                  </:item>
                  <:item title="Name">{@item.name}</:item>
                  <:item title="Manufacturer">
                    {@item.manufacturer || "—"}
                  </:item>
                  <:item title="Model / Part #">{@item.model || "—"}</:item>
                  <:item title="Description">{@item.description || "—"}</:item>
                  <:item title="Product URL">
                    <%= if @item.source_url do %>
                      <a
                        href={@item.source_url}
                        target="_blank"
                        class="link link-primary text-sm truncate max-w-xs inline-block align-bottom"
                        title={@item.source_url}
                      >
                        {@item.source_url}
                      </a>
                    <% else %>
                      —
                    <% end %>
                  </:item>
                </.list>

                <%= if @moving do %>
                  <div class="mt-4 p-4 border border-info rounded-lg bg-info/5">
                    <h4 class="font-semibold text-sm mb-3">Move to New Location</h4>
                    <.form
                      :let={f}
                      for={%{}}
                      id="move-location-form"
                      phx-submit="move_to_location"
                      phx-change="validate_move_location"
                      phx-target={@myself}
                      autocomplete="off"
                    >
                      <.ghost_autocomplete
                        id="move-location-input"
                        name={f[:location_code].name}
                        label="New Location Code"
                        placeholder="e.g., A-1"
                        value=""
                        suggestions={@location_codes}
                        required
                        autofocus
                      />

                      <%= if @move_location_warning do %>
                        <div class="alert alert-warning mt-2">
                          <.icon name="hero-exclamation-triangle" />
                          <span>
                            Location {@move_location_warning.code} has {@move_location_warning.count} active item(s).
                            Item will be co-located.
                          </span>
                        </div>
                      <% end %>

                      <%= if @move_location_error do %>
                        <div class="alert alert-error mt-2">
                          <.icon name="hero-x-circle" />
                          <span>{@move_location_error}</span>
                        </div>
                      <% end %>

                      <div class="flex gap-2 mt-3">
                        <button
                          type="submit"
                          class="btn btn-sm btn-primary"
                          disabled={@move_location_error != nil}
                        >
                          Move
                        </button>
                        <button
                          type="button"
                          phx-click="cancel_move"
                          phx-target={@myself}
                          class="btn btn-sm btn-ghost"
                        >
                          Cancel
                        </button>
                      </div>
                    </.form>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>

          <%= if not @item.archived do %>
            <div class="border rounded-lg p-4">
              <div class="flex justify-between items-center mb-4">
                <h3 class="text-lg font-semibold">In Stock</h3>
                <%= if @installed_quantity > 0 do %>
                  <span class="text-sm text-base-content/60">
                    {@installed_quantity} installed in projects
                  </span>
                <% end %>
              </div>
              <%= if @inventory_role == :owner do %>
                <div class="flex items-center justify-center gap-4">
                  <button
                    phx-click="decrement_quantity"
                    phx-target={@myself}
                    class="btn btn-circle btn-md"
                  >
                    <.icon name="hero-minus-circle" class="w-6 h-6" />
                  </button>
                  <form
                    id="quantity-update-form"
                    phx-change="update_quantity"
                    phx-target={@myself}
                    class="flex-shrink-0"
                    autocomplete="off"
                  >
                    <input
                      type="number"
                      name="quantity"
                      value={@item.quantity}
                      class="input input-bordered w-20 text-center text-xl font-bold"
                      min="0"
                    />
                  </form>
                  <button
                    phx-click="increment_quantity"
                    phx-target={@myself}
                    class="btn btn-circle btn-md"
                  >
                    <.icon name="hero-plus-circle" class="w-6 h-6" />
                  </button>
                </div>
              <% else %>
                <p class="text-center text-2xl font-bold">{@item.quantity}</p>
              <% end %>
            </div>
          <% end %>

          <div class="border rounded-lg p-4">
            <div class="flex justify-between items-center mb-4">
              <h3 class="text-lg font-semibold">Installed In</h3>
              <%= if not @item.archived and @item.quantity > 0 and not @installing and @inventory_role == :owner do %>
                <button
                  phx-click="toggle_install"
                  phx-target={@myself}
                  class="btn btn-sm btn-ghost"
                >
                  <.icon name="hero-plus" class="w-4 h-4" /> Install
                </button>
              <% end %>
            </div>

            <%= if @installing do %>
              <div class="p-4 border border-info rounded-lg bg-info/5 mb-4">
                <h4 class="font-semibold text-sm mb-3">Install in Project</h4>
                <.form
                  :let={f}
                  for={%{}}
                  id="install-item-form"
                  phx-submit="install_item"
                  phx-target={@myself}
                  autocomplete="off"
                >
                  <.ghost_autocomplete
                    id="install-project-input"
                    name={f[:project_name].name}
                    label="Project Name"
                    placeholder="e.g., ROBOT_ARM"
                    value=""
                    suggestions={@project_names}
                    required
                    autofocus
                  />

                  <.input
                    field={f[:quantity]}
                    type="number"
                    label="Quantity"
                    value="1"
                    min="1"
                    max={@item.quantity}
                    required
                  />

                  <p class="text-xs text-base-content/60 mt-1">
                    {@item.quantity} in stock
                  </p>

                  <div class="flex gap-2 mt-3">
                    <button type="submit" class="btn btn-sm btn-primary">Install</button>
                    <button
                      type="button"
                      phx-click="cancel_install"
                      phx-target={@myself}
                      class="btn btn-sm btn-ghost"
                    >
                      Cancel
                    </button>
                  </div>
                </.form>
              </div>
            <% end %>

            <%= if @installations == [] do %>
              <p class="text-sm text-base-content/60">Not installed in any projects</p>
            <% else %>
              <ul class="space-y-2">
                <%= for installation <- @installations do %>
                  <li class="flex items-center justify-between p-2 bg-base-200 rounded">
                    <span class="font-mono text-sm">
                      {installation.project_name}
                      <span class="text-base-content/60">({installation.quantity})</span>
                    </span>
                    <%= if @inventory_role == :owner do %>
                      <div class="flex items-center gap-1">
                        <button
                          phx-click="decrement_installation"
                          phx-value-installation_id={installation.id}
                          phx-target={@myself}
                          class="btn btn-xs btn-ghost font-bold"
                          title="Remove one"
                        >
                          −
                        </button>
                        <%= if not @item.archived and @item.quantity > 0 do %>
                          <button
                            phx-click="increment_installation"
                            phx-value-installation_id={installation.id}
                            phx-target={@myself}
                            class="btn btn-xs btn-ghost text-success font-bold"
                            title="Add one more"
                          >
                            +
                          </button>
                        <% end %>
                        <button
                          phx-click="uninstall_item"
                          phx-value-installation_id={installation.id}
                          phx-target={@myself}
                          class="btn btn-xs btn-ghost text-error"
                          title="Remove all"
                        >
                          <.icon name="hero-x-mark" class="w-4 h-4" />
                        </button>
                      </div>
                    <% end %>
                  </li>
                <% end %>
              </ul>
            <% end %>
          </div>

          <div class="border rounded-lg p-4">
            <div class="flex justify-between items-center mb-4">
              <h3 class="text-lg font-semibold">Availability</h3>
              <%= if @inventory_role == :owner and not @show_listing_form do %>
                <button
                  phx-click="toggle_listing_form"
                  phx-target={@myself}
                  class="btn btn-sm btn-ghost"
                >
                  <.icon name="hero-plus" class="w-4 h-4" /> List as Available
                </button>
              <% end %>
            </div>

            <%= if @inventory_role == :owner and @show_listing_form do %>
              <div class="p-4 border border-info rounded-lg bg-info/5 mb-4">
                <h4 class="font-semibold text-sm mb-3">Create Listing</h4>
                <form
                  id="create-listing-form"
                  phx-submit="create_listing"
                  phx-target={@myself}
                  class="space-y-3"
                >
                  <div>
                    <label class="label"><span class="label-text">Type</span></label>
                    <select name="type" class="select select-bordered w-full" required>
                      <option value="borrow">Borrow</option>
                      <option value="lease">Lease</option>
                      <option value="sale">Sale</option>
                    </select>
                  </div>
                  <div>
                    <label class="label"><span class="label-text">Price (optional)</span></label>
                    <input
                      type="number"
                      name="price"
                      step="0.01"
                      min="0"
                      class="input input-bordered w-full"
                      placeholder="0.00"
                    />
                  </div>
                  <div>
                    <label class="label"><span class="label-text">Notes (optional)</span></label>
                    <textarea
                      name="notes"
                      class="textarea textarea-bordered w-full"
                      rows="2"
                      placeholder="e.g., Available weekends only"
                    ></textarea>
                  </div>
                  <div class="flex gap-2">
                    <button type="submit" class="btn btn-sm btn-primary">Create Listing</button>
                    <button
                      type="button"
                      phx-click="toggle_listing_form"
                      phx-target={@myself}
                      class="btn btn-sm btn-ghost"
                    >
                      Cancel
                    </button>
                  </div>
                </form>
              </div>
            <% end %>

            <%= if @listings == [] do %>
              <p class="text-sm text-base-content/60">Not listed as available</p>
            <% else %>
              <ul class="space-y-3">
                <%= for listing <- @listings do %>
                  <li class={"p-3 rounded border #{if listing.active, do: "bg-base-200", else: "bg-base-200/50 opacity-60"}"}>
                    <div class="flex items-center justify-between">
                      <div class="flex items-center gap-2">
                        <span class={[
                          "badge badge-sm",
                          listing.type == "borrow" && "badge-info",
                          listing.type == "lease" && "badge-warning",
                          listing.type == "sale" && "badge-success"
                        ]}>
                          {String.capitalize(listing.type)}
                        </span>
                        <%= if listing.price do %>
                          <span class="text-sm font-medium">
                            ${Decimal.to_string(listing.price)}
                          </span>
                        <% end %>
                        <%= if not listing.active do %>
                          <span class="badge badge-sm badge-ghost">Inactive</span>
                        <% end %>
                      </div>
                      <%= if @inventory_role == :owner and listing.active do %>
                        <button
                          phx-click="deactivate_listing"
                          phx-value-listing-id={listing.id}
                          phx-target={@myself}
                          class="btn btn-xs btn-ghost text-error"
                          title="Deactivate listing"
                        >
                          Deactivate
                        </button>
                      <% end %>
                    </div>
                    <%= if listing.notes do %>
                      <p class="text-sm text-base-content/70 mt-1">{listing.notes}</p>
                    <% end %>

                    <%= if @inventory_role == :owner do %>
                      <%!-- Owner: show requests for this listing --%>
                      <%= if Map.has_key?(listing, :requests) and listing.requests != [] do %>
                        <div class="mt-2 space-y-1">
                          <p class="text-xs font-semibold text-base-content/60">
                            {length(listing.requests)} request(s)
                          </p>
                          <%= for request <- listing.requests do %>
                            <div class="flex items-center justify-between p-2 bg-base-100 rounded text-sm">
                              <div>
                                <span class="font-medium">{request.requester.name}</span>
                                <%= if request.message do %>
                                  <span class="text-base-content/60">
                                    &mdash; {request.message}
                                  </span>
                                <% end %>
                              </div>
                              <div>
                                <%= if request.resolved do %>
                                  <button
                                    phx-click="unresolve_request"
                                    phx-value-request-id={request.id}
                                    phx-target={@myself}
                                    class="btn btn-xs btn-ghost"
                                  >
                                    Reopen
                                  </button>
                                <% else %>
                                  <button
                                    phx-click="resolve_request"
                                    phx-value-request-id={request.id}
                                    phx-target={@myself}
                                    class="btn btn-xs btn-primary"
                                  >
                                    Resolve
                                  </button>
                                <% end %>
                              </div>
                            </div>
                          <% end %>
                        </div>
                      <% end %>
                    <% else %>
                      <%!-- Viewer: show request button or "already requested" --%>
                      <%= if listing.active do %>
                        <%= if @current_user == nil do %>
                          <p class="text-sm text-base-content/60 mt-2">
                            <.link navigate="/landing" class="link link-primary">Sign in</.link>
                            to request this item.
                          </p>
                        <% else %>
                          <%= if user_requested_listing?(listing.id, @user_requests) do %>
                            <p class="text-sm text-success mt-2">Request Sent</p>
                          <% else %>
                            <form
                              id={"request-form-#{listing.id}"}
                              phx-submit="create_request"
                              phx-target={@myself}
                              class="mt-2 flex gap-2 items-end"
                            >
                              <input type="hidden" name="listing-id" value={listing.id} />
                              <input
                                type="text"
                                name="message"
                                class="input input-bordered input-sm flex-1"
                                placeholder="Message (optional)"
                              />
                              <button type="submit" class="btn btn-sm btn-primary">
                                I'm Interested
                              </button>
                            </form>
                          <% end %>
                        <% end %>
                      <% end %>
                    <% end %>
                  </li>
                <% end %>
              </ul>
            <% end %>
          </div>

          <div class="border rounded-lg p-4">
            <div class="flex justify-between items-center mb-4">
              <h3 class="text-lg font-semibold">Documents</h3>
            </div>

            <%= if @documents == [] do %>
              <p class="text-sm text-base-content/60 mb-4">No documents attached</p>
            <% else %>
              <ul class="space-y-2 mb-4">
                <%= for doc <- @documents do %>
                  <li class="flex items-center justify-between p-2 bg-base-200 rounded">
                    <div class="flex items-center gap-2 min-w-0 flex-1">
                      <span class="text-lg">
                        {if doc.content_type == "application/pdf", do: "📄", else: "🖼️"}
                      </span>
                      <span class="text-sm truncate" title={doc.filename}>
                        {doc.filename}
                      </span>
                      <span class="text-xs text-base-content/60 shrink-0">
                        ({format_file_size(doc.size_bytes)})
                      </span>
                    </div>
                    <div class="flex items-center gap-1 shrink-0">
                      <a
                        href={safe_document_path(doc)}
                        target="_blank"
                        class="btn btn-xs btn-ghost"
                        title="Open in new tab"
                      >
                        Open
                      </a>
                      <%= if @inventory_role == :owner do %>
                        <button
                          type="button"
                          phx-click="delete_document"
                          phx-value-document_id={doc.id}
                          phx-target={@myself}
                          class="btn btn-xs btn-ghost text-error"
                          title="Delete document"
                        >
                          <.icon name="hero-x-mark" class="w-4 h-4" />
                        </button>
                      <% end %>
                    </div>
                  </li>
                <% end %>
              </ul>
            <% end %>

            <div
              :if={@inventory_role == :owner}
              class="border-2 border-dashed border-base-300 rounded-lg p-4 text-center bg-base-200 cursor-pointer hover:border-primary transition-colors"
              phx-drop-target={@uploads.document.ref}
            >
              <form
                id={"document-upload-form-#{@item.id}"}
                phx-change="document_changed"
                phx-submit="document_changed"
                phx-target={@myself}
              >
                <.live_file_input upload={@uploads.document} class="hidden" />
              </form>

              <%= for entry <- @uploads.document.entries do %>
                <div class="space-y-2">
                  <div class="flex items-center justify-center gap-2">
                    <span class="text-sm font-medium">{entry.client_name}</span>
                    <button
                      type="button"
                      phx-click="cancel_document_upload"
                      phx-value-ref={entry.ref}
                      phx-target={@myself}
                      class="btn btn-circle btn-xs btn-ghost"
                    >
                      ✕
                    </button>
                  </div>
                  <div :if={not entry.done?} class="space-y-1">
                    <progress
                      class="progress progress-primary w-full"
                      value={entry.progress}
                      max="100"
                    />
                    <p class="text-xs text-base-content/60">
                      {if entry.progress == 0,
                        do: "Starting upload...",
                        else: "Uploading #{entry.progress}%"}
                    </p>
                  </div>
                  <div :if={entry.done?} class="space-y-2">
                    <p class="text-success text-sm">✓ Ready to save</p>
                    <button
                      type="button"
                      phx-click="save_document"
                      phx-target={@myself}
                      class="btn btn-primary btn-sm"
                    >
                      Save Document
                    </button>
                  </div>
                  <%= for err <- upload_errors(@uploads.document, entry) do %>
                    <p class="text-error text-sm">{document_error_to_string(err)}</p>
                  <% end %>
                </div>
              <% end %>

              <div
                :if={@uploads.document.entries == [] && !@show_document_url_input}
                class="space-y-2"
              >
                <div class="text-2xl">📎</div>
                <div class="text-sm text-base-content/60">Drop file or click to upload</div>
                <div class="flex flex-col items-center gap-2">
                  <label for={@uploads.document.ref} class="btn btn-sm btn-outline cursor-pointer">
                    Select File
                  </label>
                  <button
                    type="button"
                    phx-click="toggle_document_url_input"
                    phx-target={@myself}
                    class="btn btn-ghost btn-xs"
                  >
                    From URL
                  </button>
                </div>
                <div class="text-xs text-base-content/40">
                  PDF, PNG, JPEG (max {@max_document_size_mb}MB)
                </div>
              </div>

              <div
                :if={@show_document_url_input && @uploads.document.entries == []}
                class="space-y-3"
              >
                <form
                  id={"document-url-form-#{@item.id}"}
                  phx-change="update_document_url"
                  phx-submit="fetch_document_from_url"
                  phx-target={@myself}
                  class="space-y-2"
                >
                  <input
                    type="url"
                    name="document_url"
                    value={@document_url}
                    placeholder="https://example.com/datasheet.pdf"
                    class="input input-bordered w-full input-sm"
                    phx-debounce="100"
                    autofocus
                  />
                  <div class="flex gap-2 justify-center">
                    <button
                      type="submit"
                      class="btn btn-primary btn-sm"
                      disabled={@fetching_document_url or @document_url == ""}
                    >
                      {if @fetching_document_url, do: "Fetching...", else: "Fetch"}
                    </button>
                    <button
                      type="button"
                      phx-click="cancel_document_url_input"
                      phx-target={@myself}
                      class="btn btn-ghost btn-sm"
                    >
                      Cancel
                    </button>
                  </div>
                </form>
              </div>
            </div>
          </div>

          <%= if @inventory_role == :owner do %>
            <%= if not @item.archived do %>
              <div class="border-t pt-4">
                <.button
                  phx-click="archive"
                  phx-target={@myself}
                  data-confirm="Archive this item? Its location will be freed for reuse and the item quantity will be set to 0."
                  class="w-full btn btn-outline btn-warning btn-sm"
                >
                  Archive Item
                </.button>
              </div>
            <% else %>
              <div class="border-t pt-4">
                <.button phx-click="show_restore_modal" phx-target={@myself} class="w-full btn-sm">
                  Restore Item
                </.button>
                <p class="mt-2 text-sm text-gray-600">
                  Restore this item by assigning a new location and quantity.
                </p>
              </div>
            <% end %>

            <div class="border-t pt-4">
              <button
                type="button"
                phx-click="show_delete_modal"
                phx-target={@myself}
                class="btn btn-outline btn-error btn-sm w-full"
              >
                🗑️ Delete Permanently
              </button>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
  
<!-- Restore Modal (nested) -->
  <div
    :if={@show_restore_modal}
    class="modal modal-open"
    style="z-index: 1000;"
    phx-window-keydown="close_restore_modal"
    phx-key="escape"
    phx-target={@myself}
  >
    <div class="modal-box" phx-click-away="close_restore_modal" phx-target={@myself}>
      <h3 class="font-bold text-lg">Restore Item</h3>
      <p class="py-4 text-sm text-gray-600">
        <%= if @pending_restore_quantity do %>
          Choose a location for the {@pending_restore_quantity} item(s) returned from the project.
        <% else %>
          Assign a new location and quantity to restore this item.
        <% end %>
      </p>

      <.form
        :let={f}
        for={%{}}
        id="restore-item-form"
        phx-submit="restore"
        phx-change="validate_location"
        phx-target={@myself}
        autocomplete="off"
      >
        <.ghost_autocomplete
          id="restore-location-input"
          name={f[:location_code].name}
          label="Location Code"
          placeholder="e.g., A-1"
          suggestions={@location_codes}
          required
          autofocus
        />

        <%= if @location_warning do %>
          <div class="alert alert-warning mt-2">
            <.icon name="hero-exclamation-triangle" />
            <span>
              Location {@location_warning.code} has {@location_warning.count} active item(s).
              Item will be co-located.
            </span>
          </div>
        <% end %>

        <%= if @location_error do %>
          <div class="alert alert-error mt-2">
            <.icon name="hero-x-circle" />
            <span>{@location_error}</span>
          </div>
        <% end %>

        <.input
          field={f[:quantity]}
          type="number"
          label="Quantity"
          value={@pending_restore_quantity || 1}
          min="1"
          required
        />

        <div class="modal-action">
          <button
            type="button"
            class="btn btn-ghost"
            phx-click="close_restore_modal"
            phx-target={@myself}
          >
            Cancel
          </button>
          <button type="submit" class="btn btn-primary" disabled={@location_error != nil}>
            Restore
          </button>
        </div>
      </.form>
    </div>
  </div>
  
<!-- Archive from Quantity Modal (nested) -->
  <div
    :if={@show_archive_quantity_modal}
    class="modal modal-open"
    style="z-index: 1000;"
    phx-window-keydown="cancel_archive_from_quantity"
    phx-key="escape"
    phx-target={@myself}
  >
    <div class="modal-box" phx-click-away="cancel_archive_from_quantity" phx-target={@myself}>
      <h3 class="font-bold text-lg">Archive Item?</h3>
      <p class="py-4 text-sm text-gray-600">
        Setting quantity to 0 will archive this item. Its location will be freed for reuse.
      </p>

      <div class="modal-action">
        <button
          type="button"
          class="btn btn-ghost"
          phx-click="cancel_archive_from_quantity"
          phx-target={@myself}
        >
          Cancel
        </button>
        <button
          type="button"
          class="btn btn-error"
          phx-click="confirm_archive_from_quantity"
          phx-target={@myself}
        >
          Archive Item
        </button>
      </div>
    </div>
  </div>
  
<!-- Delete Confirmation Modal (nested) -->
  <div
    :if={@show_delete_modal}
    class="modal modal-open"
    style="z-index: 1000;"
    phx-window-keydown="hide_delete_modal"
    phx-key="escape"
    phx-target={@myself}
  >
    <div class="modal-box">
      <h3 class="font-bold text-lg text-error">Delete Item Permanently?</h3>
      <p class="py-4">
        Are you sure you want to permanently delete <strong>{@item.name}</strong>?
        This will remove the item from the database and cannot be undone.
      </p>

      <div class="modal-action">
        <button
          type="button"
          class="btn btn-ghost"
          phx-click="hide_delete_modal"
          phx-target={@myself}
        >
          Cancel
        </button>
        <button
          type="button"
          class="btn btn-error"
          phx-click="delete"
          phx-target={@myself}
        >
          🗑️ Delete Forever
        </button>
      </div>
    </div>
    <div class="modal-backdrop bg-black/50" phx-click="hide_delete_modal" phx-target={@myself}>
    </div>
  </div>
</div>
