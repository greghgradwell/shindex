<.header>
  Items
  <:subtitle>
    <%= if @view_mode == :search do %>
      {if @query == "" and @active_filters == [],
        do: "Enter a search query or select filters",
        else: "#{length(@results)} results"}
    <% else %>
      {length(@items)} items
    <% end %>
  </:subtitle>
</.header>

<div class="tabs tabs-boxed mt-6 w-fit">
  <.link navigate={~p"/"} class={"tab #{if @view_mode == :search, do: "tab-active"}"}>
    <.icon name="hero-magnifying-glass" class="w-4 h-4 mr-1" /> Search
  </.link>
  <.link navigate={~p"/?view=table"} class={"tab #{if @view_mode == :table, do: "tab-active"}"}>
    <.icon name="hero-table-cells" class="w-4 h-4 mr-1" /> Browse
  </.link>
</div>

<div class="mt-4">
  <label class="flex items-center gap-2 cursor-pointer">
    <input
      type="checkbox"
      phx-click="toggle_archived"
      checked={@show_archived}
      class="checkbox checkbox-sm"
    />
    <span class="text-sm">Show archived items</span>
  </label>
</div>

<%= if @view_mode == :search do %>
  <.search_view query={@query} results={@results} active_filters={@active_filters} />
<% else %>
  <.table_view items={@items} sort_by={@sort_by} sort_order={@sort_order} />
<% end %>

<.live_component
  :if={@selected_item_id}
  module={InventoryLocatorWeb.ItemLive.ShowModal}
  id="item-show-modal"
  item_id={@selected_item_id}
  batch_mode={@batch_mode}
  batch_total={length(@batch_item_ids)}
/>
