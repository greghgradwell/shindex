<div class="max-w-4xl mx-auto">
  <.header>
    {@item.name}
    <:subtitle>
      <%= if @item.archived do %>
        <span class="inline-block px-2 py-1 bg-gray-200 text-gray-700 text-xs rounded">
          Archived
        </span>
      <% else %>
        {if @item.location, do: @item.location.full_code, else: "No location"}
      <% end %>
    </:subtitle>
    <:actions>
      <.link navigate={~p"/items"} class="text-sm text-blue-600 hover:text-blue-800">
        ← Back to Search
      </.link>
    </:actions>
  </.header>

  <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-8">
    <!-- Photo Section -->
    <div>
      <%= if @item.photo_path do %>
        <img
          src={"/uploads/#{@item.photo_path}"}
          alt={@item.name}
          class="w-full h-96 object-cover rounded-lg shadow-lg"
        />
      <% else %>
        <div class="w-full h-96 bg-gray-200 rounded-lg flex items-center justify-center">
          <.icon name="hero-photo" class="w-24 h-24 text-gray-400" />
        </div>
      <% end %>
    </div>
    
<!-- Details Section -->
    <div class="space-y-6">
      <!-- Metadata -->
      <div class="border rounded-lg p-4">
        <div class="flex justify-between items-center mb-4">
          <h3 class="text-lg font-semibold">Details</h3>
          <%= if not @editing do %>
            <button phx-click="toggle_edit" class="btn btn-sm btn-ghost">
              <.icon name="hero-pencil" class="w-4 h-4" /> Edit
            </button>
          <% end %>
        </div>

        <%= if @editing do %>
          <div id="edit-form-container">
            <.form
              :let={f}
              for={@edit_changeset}
              id="item-details-form"
              phx-submit="update_item_details"
            >
              <.input field={f[:name]} type="text" label="Name" value={@item.name} required />
              <.input
                field={f[:manufacturer]}
                type="text"
                label="Manufacturer"
                value={@item.manufacturer}
              />
              <.input field={f[:model]} type="text" label="Model" value={@item.model} />
              <.input
                field={f[:description]}
                type="text"
                label="Description"
                value={@item.description}
              />

              <div class="flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">Save</button>
                <button type="button" phx-click="cancel_edit" class="btn btn-ghost">
                  Cancel
                </button>
              </div>
            </.form>
          </div>
        <% else %>
          <div id="view-mode-container">
            <.list>
              <:item title="Location">
                <div class="flex items-center justify-between gap-2">
                  <span>
                    {if @item.location,
                      do: @item.location.full_code,
                      else: "No location (archived)"}
                  </span>
                  <%= if not @item.archived do %>
                    <button phx-click="toggle_move" class="btn btn-xs btn-ghost">
                      <.icon name="hero-arrow-right-circle" class="w-4 h-4" /> Move
                    </button>
                  <% end %>
                </div>
              </:item>
              <:item title="Name">{@item.name}</:item>
              <:item :if={@item.manufacturer} title="Manufacturer">{@item.manufacturer}</:item>
              <:item :if={@item.model} title="Model">{@item.model}</:item>
              <:item :if={@item.description} title="Description">{@item.description}</:item>
            </.list>

            <%= if @moving do %>
              <div class="mt-4 p-4 border border-info rounded-lg bg-info/5">
                <h4 class="font-semibold text-sm mb-3">Move to New Location</h4>
                <.form
                  :let={f}
                  for={%{}}
                  id="move-location-form"
                  phx-submit="move_to_location"
                  phx-change="validate_move_location"
                >
                  <.input
                    field={f[:location_code]}
                    type="text"
                    label="New Location Code"
                    placeholder="e.g., A-1-1"
                    value={@item.location && @item.location.full_code}
                    required
                  />

                  <%= if assigns[:move_location_warning] do %>
                    <div class="alert alert-warning mt-2">
                      <.icon name="hero-exclamation-triangle" />
                      <span>
                        Location {@move_location_warning.code} has {@move_location_warning.count} active item(s).
                        Item will be co-located.
                      </span>
                    </div>
                  <% end %>

                  <div class="flex gap-2 mt-3">
                    <button type="submit" class="btn btn-sm btn-primary">Move</button>
                    <button type="button" phx-click="cancel_move" class="btn btn-sm btn-ghost">
                      Cancel
                    </button>
                  </div>
                </.form>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
      
<!-- Quantity Controls -->
      <%= if not @item.archived do %>
        <div class="border rounded-lg p-6">
          <h3 class="text-lg font-semibold mb-4">Quantity</h3>
          <div class="flex items-center justify-center gap-4">
            <button
              phx-click="decrement_quantity"
              class="btn btn-circle btn-lg"
              disabled={@item.quantity == 0}
            >
              <.icon name="hero-minus-circle" class="w-8 h-8" />
            </button>
            <form id="quantity-update-form" phx-change="update_quantity" class="flex-shrink-0">
              <input
                type="number"
                name="quantity"
                value={@item.quantity}
                class="input input-bordered w-24 text-center text-2xl font-bold"
                min="0"
              />
            </form>
            <button phx-click="increment_quantity" class="btn btn-circle btn-lg">
              <.icon name="hero-plus-circle" class="w-8 h-8" />
            </button>
          </div>
        </div>
      <% end %>
      
<!-- Archive Section -->
      <%= if not @item.archived do %>
        <div class="border-t pt-6">
          <.button
            phx-click="archive"
            data-confirm="Archive this item? Its location will be freed for reuse and the item quantity will be set to 0."
            class="w-full btn btn-outline btn-error"
          >
            Archive Item
          </.button>
        </div>
      <% else %>
        <div class="border-t pt-6">
          <.button phx-click="show_restore_modal" class="w-full">
            Restore Item
          </.button>
          <p class="mt-2 text-sm text-gray-600">
            Restore this item by assigning a new location and quantity.
          </p>
        </div>
      <% end %>
    </div>
  </div>
</div>
<!-- Restore Modal -->
<div
  :if={@show_restore_modal}
  class="modal modal-open"
  phx-click="close_restore_modal"
  phx-key="escape"
>
  <div class="modal-box" phx-click-away="close_restore_modal">
    <h3 class="font-bold text-lg">Restore Item</h3>
    <p class="py-4 text-sm text-gray-600">
      Assign a new location and quantity to restore this item.
    </p>

    <.form
      :let={f}
      for={%{}}
      id="restore-item-form"
      phx-submit="restore"
      phx-change="validate_location"
    >
      <.input
        field={f[:location_code]}
        type="text"
        label="Location Code"
        placeholder="e.g., A-1-1"
        required
      />

      <%= if assigns[:location_warning] do %>
        <div class="alert alert-warning mt-2">
          <.icon name="hero-exclamation-triangle" />
          <span>
            Location {@location_warning.code} has {@location_warning.count} active item(s).
            Item will be co-located.
          </span>
        </div>
      <% end %>

      <.input
        field={f[:quantity]}
        type="number"
        label="Quantity"
        value="1"
        min="1"
        required
      />

      <div class="modal-action">
        <button type="button" class="btn btn-ghost" phx-click="close_restore_modal">
          Cancel
        </button>
        <button type="submit" class="btn btn-primary">
          Restore
        </button>
      </div>
    </.form>
  </div>
</div>
