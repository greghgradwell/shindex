<div class="max-w-2xl mx-auto p-4">
  <%= if @current_item do %>
    <div class="card bg-base-100 shadow-xl">
      <figure class="px-4 pt-4">
        <%= if @current_item.photo_path do %>
          <img
            src={~p"/uploads/#{@current_item.photo_path}"}
            alt={@current_item.name}
            class="rounded-xl max-h-96 object-contain"
          />
        <% else %>
          <div class="w-full h-64 bg-base-200 rounded-xl flex items-center justify-center">
            <span class="text-6xl">📦</span>
          </div>
        <% end %>
      </figure>

      <div class="card-body">
        <h2 class="card-title text-2xl">{@current_item.name}</h2>

        <div class="grid grid-cols-2 gap-4 mt-4">
          <div class="stat bg-base-200 rounded-lg p-4">
            <div class="stat-title text-xs">Location</div>
            <div class="stat-value text-lg font-mono">
              <%= if @current_item.location do %>
                {@current_item.location.full_code}
              <% else %>
                <span class="text-base-content/40">—</span>
              <% end %>
            </div>
          </div>

          <div class="stat bg-base-200 rounded-lg p-4">
            <div class="stat-title text-xs">Quantity</div>
            <div class="stat-value text-lg">{@current_item.quantity}</div>
          </div>
        </div>

        <div class="divider">Details</div>

        <div class="space-y-3">
          <div class={"p-3 rounded-lg #{if is_nil(@current_item.manufacturer), do: "bg-warning/20 border border-warning", else: "bg-base-200"}"}>
            <div class="text-xs text-base-content/60 uppercase tracking-wide">Manufacturer</div>
            <div class="font-medium mt-1">
              <%= if @current_item.manufacturer do %>
                {@current_item.manufacturer}
              <% else %>
                <span class="text-warning">⚠️ Missing</span>
              <% end %>
            </div>
          </div>

          <div class={"p-3 rounded-lg #{if is_nil(@current_item.model), do: "bg-warning/20 border border-warning", else: "bg-base-200"}"}>
            <div class="text-xs text-base-content/60 uppercase tracking-wide">Model / Part #</div>
            <div class="font-medium mt-1">
              <%= if @current_item.model do %>
                {@current_item.model}
              <% else %>
                <span class="text-warning">⚠️ Missing</span>
              <% end %>
            </div>
          </div>

          <div class={"p-3 rounded-lg #{if is_nil(@current_item.description), do: "bg-warning/20 border border-warning", else: "bg-base-200"}"}>
            <div class="text-xs text-base-content/60 uppercase tracking-wide">Description</div>
            <div class="font-medium mt-1">
              <%= if @current_item.description do %>
                {@current_item.description}
              <% else %>
                <span class="text-warning">⚠️ Missing</span>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% else %>
    <div class="hero min-h-[60vh]">
      <div class="hero-content text-center">
        <div class="max-w-md">
          <div class="text-8xl mb-8 animate-pulse">📡</div>
          <h1 class="text-3xl font-bold">Assist Mode</h1>
          <p class="py-6 text-base-content/70">
            Waiting for Claude Code to select an item...
          </p>
          <div class="text-sm text-base-content/50 mt-4 p-4 bg-base-200 rounded-lg text-left font-mono">
            <div class="mb-2">API endpoints:</div>
            <div>GET /api/assist/items</div>
            <div>POST /api/assist/items/:id/show</div>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
