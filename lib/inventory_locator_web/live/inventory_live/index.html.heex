<.header>
  Inventories
  <:actions>
    <.button phx-click="show_create_modal">
      <.icon name="hero-plus" class="w-4 h-4 mr-1" /> New Inventory
    </.button>
  </:actions>
</.header>

<div class="mt-6">
  <div class="overflow-x-auto">
    <table class="table table-zebra">
      <thead>
        <tr>
          <th>Name</th>
          <th>Description</th>
          <th class="text-right">Shelves</th>
          <th class="text-right">Items</th>
          <th class="text-right">Actions</th>
        </tr>
      </thead>
      <tbody>
        <%= for {inv, shelf_count, item_count} <- @inventories_with_counts do %>
          <tr>
            <td class="font-medium">
              {inv.name}
              <span
                :if={current_inventory?(inv, @current_inventory)}
                class="badge badge-primary badge-sm ml-2"
              >
                Current
              </span>
            </td>
            <td class="text-base-content/70">{inv.description || "—"}</td>
            <td class="text-right">{shelf_count}</td>
            <td class="text-right">{item_count}</td>
            <td class="text-right">
              <div class="flex justify-end gap-2">
                <button
                  class="btn btn-ghost btn-sm"
                  phx-click="show_edit_modal"
                  phx-value-id={inv.id}
                  title="Edit"
                >
                  <.icon name="hero-pencil" class="w-4 h-4" />
                </button>
                <button
                  class="btn btn-ghost btn-sm text-error"
                  phx-click="show_delete_modal"
                  phx-value-id={inv.id}
                  phx-value-shelves={shelf_count}
                  phx-value-items={item_count}
                  title="Delete"
                  disabled={current_inventory?(inv, @current_inventory)}
                >
                  <.icon name="hero-trash" class="w-4 h-4" />
                </button>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<%!-- Create Modal --%>
<div
  :if={@show_create_modal}
  class="modal modal-open"
  phx-window-keydown="close_create_modal"
  phx-key="escape"
>
  <div class="modal-box" phx-click-away="close_create_modal">
    <h3 class="font-bold text-lg mb-4">Create New Inventory</h3>

    <form phx-submit="create_inventory" phx-change="validate_name" autocomplete="off">
      <div class="form-control mb-4">
        <label class="label">
          <span class="label-text">Name</span>
        </label>
        <input
          type="text"
          name="name"
          id="create-inventory-name"
          placeholder="e.g., Workshop, Garage, Home"
          class={["input input-bordered w-full", @name_error && "input-error"]}
          required
          maxlength="50"
          phx-mounted={JS.focus()}
        />
        <label :if={@name_error} class="label">
          <span class="label-text-alt text-error">{@name_error}</span>
        </label>
      </div>

      <div class="form-control mb-4">
        <label class="label">
          <span class="label-text">Description (optional)</span>
        </label>
        <input
          type="text"
          name="description"
          placeholder="Brief description"
          class="input input-bordered w-full"
        />
      </div>

      <div class="modal-action">
        <button type="button" class="btn btn-ghost" phx-click="close_create_modal">
          Cancel
        </button>
        <button type="submit" class="btn btn-primary" disabled={@name_error != nil}>
          Create
        </button>
      </div>
    </form>
  </div>
</div>

<%!-- Edit Modal --%>
<div
  :if={@show_edit_modal}
  class="modal modal-open"
  phx-window-keydown="close_edit_modal"
  phx-key="escape"
>
  <div class="modal-box" phx-click-away="close_edit_modal">
    <h3 class="font-bold text-lg mb-4">Edit Inventory</h3>

    <form phx-submit="update_inventory" phx-change="validate_name" autocomplete="off">
      <div class="form-control mb-4">
        <label class="label">
          <span class="label-text">Name</span>
        </label>
        <input
          type="text"
          name="name"
          id="edit-inventory-name"
          value={@edit_inventory && @edit_inventory.name}
          class={["input input-bordered w-full", @name_error && "input-error"]}
          required
          maxlength="50"
          phx-mounted={JS.focus()}
        />
        <label :if={@name_error} class="label">
          <span class="label-text-alt text-error">{@name_error}</span>
        </label>
      </div>

      <div class="form-control mb-4">
        <label class="label">
          <span class="label-text">Description (optional)</span>
        </label>
        <input
          type="text"
          name="description"
          value={@edit_inventory && @edit_inventory.description}
          placeholder="Brief description"
          class="input input-bordered w-full"
        />
      </div>

      <div class="modal-action">
        <button type="button" class="btn btn-ghost" phx-click="close_edit_modal">
          Cancel
        </button>
        <button type="submit" class="btn btn-primary" disabled={@name_error != nil}>
          Save Changes
        </button>
      </div>
    </form>
  </div>
</div>

<%!-- Delete Modal --%>
<div
  :if={@show_delete_modal}
  class="modal modal-open"
  phx-window-keydown="close_delete_modal"
  phx-key="escape"
>
  <div class="modal-box border-2 border-error">
    <h3 class="font-bold text-lg text-error mb-4">
      <.icon name="hero-exclamation-triangle" class="w-5 h-5 inline-block mr-1" />
      Delete Inventory
    </h3>

    <div class="alert alert-error mb-4">
      <.icon name="hero-exclamation-circle" class="w-5 h-5" />
      <span>This action cannot be undone!</span>
    </div>

    <div class="bg-base-200 rounded-lg p-4 mb-4">
      <p class="font-semibold">{@delete_inventory && @delete_inventory.name}</p>
      <ul class="text-sm mt-2 text-base-content/70">
        <li>{@delete_shelf_count} shelves will be deleted</li>
        <li>{@delete_item_count} items will be deleted</li>
      </ul>
    </div>

    <form phx-submit="delete_inventory" phx-change="validate_delete">
      <div class="form-control mb-4">
        <label class="label">
          <span class="label-text">
            Type
            <code class="font-bold bg-base-300 px-1 rounded">
              {@delete_inventory && @delete_inventory.name}
            </code>
            to confirm
          </span>
        </label>
        <input
          type="text"
          name="confirmation"
          value={@delete_confirmation}
          class="input input-bordered"
          autocomplete="off"
          phx-mounted={JS.focus()}
        />
      </div>

      <div class="modal-action">
        <button type="button" class="btn btn-ghost" phx-click="close_delete_modal">
          Cancel
        </button>
        <button
          type="submit"
          class="btn btn-error"
          disabled={@delete_inventory && @delete_confirmation != @delete_inventory.name}
        >
          Delete Forever
        </button>
      </div>
    </form>
  </div>
</div>
