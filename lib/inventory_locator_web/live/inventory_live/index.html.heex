<.header>
  Inventories
  <:actions>
    <.button phx-click="show_create_modal">
      <.icon name="hero-plus" class="w-4 h-4 mr-1" /> New Inventory
    </.button>
  </:actions>
</.header>

<div class="mt-6">
  <%= if @inventories_with_counts == [] do %>
    <div class="text-center py-12">
      <.icon name="hero-archive-box" class="w-12 h-12 mx-auto text-base-content/30" />
      <p class="mt-4 text-base-content/70">You don't have any inventories yet.</p>
      <p class="text-base-content/50">
        Create one to get started, or ask someone to share theirs.
      </p>
    </div>
  <% else %>
    <div class="overflow-x-auto">
      <table class="table table-zebra">
        <thead>
          <tr>
            <th>Name</th>
            <th>Description</th>
            <th class="text-right">Shelves</th>
            <th class="text-right">Items</th>
            <th class="text-right">Actions</th>
          </tr>
        </thead>
        <tbody>
          <%= for {inv, shelf_count, item_count} <- @inventories_with_counts do %>
            <tr>
              <td class="font-medium">
                {inv.name}
                <span
                  :if={current_inventory?(inv, @current_inventory)}
                  class="badge badge-primary badge-sm ml-2"
                >
                  Current
                </span>
                <span
                  :if={not owned?(inv, @current_user.id)}
                  class="badge badge-ghost badge-sm ml-1"
                >
                  Shared
                </span>
              </td>
              <td class="text-base-content/70">{inv.description || "—"}</td>
              <td class="text-right">{shelf_count}</td>
              <td class="text-right">{item_count}</td>
              <td class="text-right">
                <%= if owned?(inv, @current_user.id) do %>
                  <div class="flex justify-end gap-2">
                    <button
                      class="btn btn-ghost btn-sm"
                      phx-click="show_share_modal"
                      phx-value-id={inv.id}
                      title="Share"
                    >
                      <.icon name="hero-share" class="w-4 h-4" />
                    </button>
                    <button
                      class="btn btn-ghost btn-sm"
                      phx-click="show_edit_modal"
                      phx-value-id={inv.id}
                      title="Edit"
                    >
                      <.icon name="hero-pencil" class="w-4 h-4" />
                    </button>
                    <button
                      class="btn btn-ghost btn-sm text-error"
                      phx-click="show_delete_modal"
                      phx-value-id={inv.id}
                      phx-value-shelves={shelf_count}
                      phx-value-items={item_count}
                      title="Delete"
                      disabled={current_inventory?(inv, @current_inventory)}
                    >
                      <.icon name="hero-trash" class="w-4 h-4" />
                    </button>
                  </div>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>

<%!-- Create Modal --%>
<div
  :if={@show_create_modal}
  class="modal modal-open"
  phx-window-keydown="close_create_modal"
  phx-key="escape"
>
  <div class="modal-box" phx-click-away="close_create_modal">
    <h3 class="font-bold text-lg mb-4">Create New Inventory</h3>

    <form phx-submit="create_inventory" phx-change="validate_name" autocomplete="off">
      <div class="form-control mb-4">
        <label class="label">
          <span class="label-text">Name</span>
        </label>
        <input
          type="text"
          name="name"
          id="create-inventory-name"
          placeholder="e.g., Workshop, Garage, Home"
          class={["input input-bordered w-full", @name_error && "input-error"]}
          required
          maxlength="50"
          phx-mounted={JS.focus()}
        />
        <label :if={@name_error} class="label">
          <span class="label-text-alt text-error">{@name_error}</span>
        </label>
      </div>

      <div class="form-control mb-4">
        <label class="label">
          <span class="label-text">Description (optional)</span>
        </label>
        <input
          type="text"
          name="description"
          placeholder="Brief description"
          class="input input-bordered w-full"
        />
      </div>

      <div class="modal-action">
        <button type="button" class="btn btn-ghost" phx-click="close_create_modal">
          Cancel
        </button>
        <button type="submit" class="btn btn-primary" disabled={@name_error != nil}>
          Create
        </button>
      </div>
    </form>
  </div>
</div>

<%!-- Edit Modal --%>
<div
  :if={@show_edit_modal}
  class="modal modal-open"
  phx-window-keydown="close_edit_modal"
  phx-key="escape"
>
  <div class="modal-box" phx-click-away="close_edit_modal">
    <h3 class="font-bold text-lg mb-4">Edit Inventory</h3>

    <form phx-submit="update_inventory" phx-change="validate_name" autocomplete="off">
      <div class="form-control mb-4">
        <label class="label">
          <span class="label-text">Name</span>
        </label>
        <input
          type="text"
          name="name"
          id="edit-inventory-name"
          value={@edit_inventory && @edit_inventory.name}
          class={["input input-bordered w-full", @name_error && "input-error"]}
          required
          maxlength="50"
          phx-mounted={JS.focus()}
        />
        <label :if={@name_error} class="label">
          <span class="label-text-alt text-error">{@name_error}</span>
        </label>
      </div>

      <div class="form-control mb-4">
        <label class="label">
          <span class="label-text">Description (optional)</span>
        </label>
        <input
          type="text"
          name="description"
          value={@edit_inventory && @edit_inventory.description}
          placeholder="Brief description"
          class="input input-bordered w-full"
        />
      </div>

      <div class="modal-action">
        <button type="button" class="btn btn-ghost" phx-click="close_edit_modal">
          Cancel
        </button>
        <button type="submit" class="btn btn-primary" disabled={@name_error != nil}>
          Save Changes
        </button>
      </div>
    </form>
  </div>
</div>

<%!-- Delete Modal --%>
<div
  :if={@show_delete_modal}
  class="modal modal-open"
  phx-window-keydown="close_delete_modal"
  phx-key="escape"
>
  <div class="modal-box border-2 border-error">
    <h3 class="font-bold text-lg text-error mb-4">
      <.icon name="hero-exclamation-triangle" class="w-5 h-5 inline-block mr-1" />
      Delete Inventory
    </h3>

    <div class="alert alert-error mb-4">
      <.icon name="hero-exclamation-circle" class="w-5 h-5" />
      <span>This action cannot be undone!</span>
    </div>

    <div class="bg-base-200 rounded-lg p-4 mb-4">
      <p class="font-semibold">{@delete_inventory && @delete_inventory.name}</p>
      <ul class="text-sm mt-2 text-base-content/70">
        <li>{@delete_shelf_count} shelves will be deleted</li>
        <li>{@delete_item_count} items will be deleted</li>
      </ul>
    </div>

    <form phx-submit="delete_inventory" phx-change="validate_delete">
      <div class="form-control mb-4">
        <label class="label">
          <span class="label-text">
            Type
            <code class="font-bold bg-base-300 px-1 rounded">
              {@delete_inventory && @delete_inventory.name}
            </code>
            to confirm
          </span>
        </label>
        <input
          type="text"
          name="confirmation"
          value={@delete_confirmation}
          class="input input-bordered"
          autocomplete="off"
          phx-mounted={JS.focus()}
        />
      </div>

      <div class="modal-action">
        <button type="button" class="btn btn-ghost" phx-click="close_delete_modal">
          Cancel
        </button>
        <button
          type="submit"
          class="btn btn-error"
          disabled={@delete_inventory && @delete_confirmation != @delete_inventory.name}
        >
          Delete Forever
        </button>
      </div>
    </form>
  </div>
</div>

<%!-- Share Modal --%>
<div
  :if={@show_share_modal}
  class="modal modal-open"
  phx-window-keydown="close_share_modal"
  phx-key="escape"
>
  <div class="modal-box max-w-2xl" phx-click-away="close_share_modal">
    <h3 class="font-bold text-lg mb-4">
      <.icon name="hero-share" class="w-5 h-5 inline-block mr-1" />
      Share {@share_inventory && @share_inventory.name}
    </h3>

    <%!-- Public Link (guest access, no account required) --%>
    <div class="mb-6">
      <h4 class="font-semibold mb-2">Public Link</h4>
      <p class="text-sm text-base-content/60 mb-2">
        Anyone with this link can browse your inventory (read-only, no account required).
      </p>
      <%= if @public_link do %>
        <div class="flex items-center gap-2">
          <code class="text-xs break-all flex-1 bg-base-200 p-2 rounded">
            {public_link_url(@public_link.code)}
          </code>
          <button
            class="btn btn-ghost btn-sm"
            onclick={"navigator.clipboard.writeText('#{public_link_url(@public_link.code)}')"}
            title="Copy link"
          >
            <.icon name="hero-clipboard-document" class="w-4 h-4" />
          </button>
          <button
            class="btn btn-ghost btn-sm text-error"
            phx-click="revoke_public_link"
            title="Revoke"
          >
            <.icon name="hero-trash" class="w-4 h-4" />
          </button>
        </div>
      <% else %>
        <button class="btn btn-primary btn-sm" phx-click="generate_public_link">
          Generate Public Link
        </button>
      <% end %>
    </div>

    <div class="divider my-2"></div>

    <%!-- Invite Link (requires account) --%>
    <div class="mb-6">
      <div class="flex items-center justify-between mb-2">
        <h4 class="font-semibold">Invite Link</h4>
        <button class="btn btn-primary btn-sm" phx-click="generate_share_code">
          Generate New Link
        </button>
      </div>
      <%= if @new_share_code do %>
        <div class="alert alert-success mt-2">
          <div>
            <p class="text-sm font-semibold">
              Share this link (one-time use, expires in 7 days):
            </p>
            <code class="text-xs break-all">{share_url(@new_share_code)}</code>
          </div>
        </div>
      <% end %>
    </div>

    <%!-- Share Codes --%>
    <%= if @share_codes != [] do %>
      <div class="mb-6">
        <h4 class="font-semibold mb-2">Share Codes</h4>
        <div class="overflow-x-auto">
          <table class="table table-sm">
            <thead>
              <tr>
                <th>Code</th>
                <th>Status</th>
                <th>Used By</th>
              </tr>
            </thead>
            <tbody>
              <%= for sc <- @share_codes do %>
                <tr>
                  <td class="font-mono text-xs">{sc.code}</td>
                  <td>
                    <% status = share_code_status(sc) %>
                    <span class={[
                      "badge badge-sm",
                      status == "Active" && "badge-success",
                      status == "Used" && "badge-ghost",
                      status == "Expired" && "badge-warning"
                    ]}>
                      {status}
                    </span>
                  </td>
                  <td class="text-sm">{sc.used_by && sc.used_by.name}</td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>

    <%!-- Friends --%>
    <%= if @friends != [] do %>
      <div class="mb-6">
        <h4 class="font-semibold mb-2">Friends</h4>
        <div class="space-y-2">
          <%= for friend <- @friends do %>
            <div class="flex items-center justify-between bg-base-200 rounded-lg px-4 py-2">
              <div class="flex items-center gap-2">
                <%= if friend.user.avatar_url do %>
                  <img src={friend.user.avatar_url} class="w-6 h-6 rounded-full" />
                <% end %>
                <span>{friend.user.name}</span>
                <span class="badge badge-ghost badge-sm">{friend.role}</span>
              </div>
              <button
                class="btn btn-ghost btn-xs text-error"
                phx-click="remove_friend"
                phx-value-user-id={friend.user_id}
                title="Remove"
              >
                <.icon name="hero-x-mark" class="w-4 h-4" />
              </button>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="modal-action">
      <button type="button" class="btn btn-ghost" phx-click="close_share_modal">
        Close
      </button>
    </div>
  </div>
</div>
