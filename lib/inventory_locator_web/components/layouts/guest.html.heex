<div class="alert alert-info mb-6 flex items-center justify-between">
  <span>
    <.icon name="hero-eye" class="w-4 h-4 inline-block mr-1" />
    Viewing <strong>{@current_inventory.name}</strong> as a guest (read-only).
  </span>
  <.link navigate="/landing" class="btn btn-primary btn-sm">
    Sign in
  </.link>
</div>
<InventoryLocatorWeb.Layouts.flash_group flash={@flash} />
{@inner_content}
