<div class="max-w-md mx-auto mt-12">
  <div class="card bg-base-200 shadow-lg">
    <div class="card-body">
      <h2 class="card-title text-xl">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="w-6 h-6"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M7.217 10.907a2.25 2.25 0 1 0 0 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186 9.566-5.314m-9.566 7.5 9.566 5.314m0 0a2.25 2.25 0 1 0 3.935 2.186 2.25 2.25 0 0 0-3.935-2.186Zm0-12.814a2.25 2.25 0 1 0 3.933-2.185 2.25 2.25 0 0 0-3.933 2.185Z"
          />
        </svg>
        Shared Inventory
      </h2>

      <div class="mt-4 space-y-2">
        <div class="flex justify-between">
          <span class="text-base-content/70">Inventory</span>
          <span class="font-semibold">{@info.inventory_name}</span>
        </div>
        <div class="flex justify-between">
          <span class="text-base-content/70">Shared by</span>
          <span class="font-semibold">{@info.shared_by}</span>
        </div>
        <div class="flex justify-between">
          <span class="text-base-content/70">Access</span>
          <span class="badge badge-ghost">Read-only</span>
        </div>
      </div>

      <div class="card-actions justify-end mt-6">
        <.link navigate="/" class="btn btn-ghost">Cancel</.link>
        <form action={~p"/share/#{@code}/redeem"} method="post">
          <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
          <button type="submit" class="btn btn-primary">Accept Invite</button>
        </form>
      </div>
    </div>
  </div>
</div>
