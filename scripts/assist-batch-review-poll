#!/usr/bin/env bash
# Poll until user clicks "Save All" on the batch review page
# Usage: ./scripts/assist-batch-review-poll [timeout_seconds]

set -e

TIMEOUT=${1:-600}
ELAPSED=0

while [ $ELAPSED -lt $TIMEOUT ]; do
  result=$(curl -s "http://localhost:4000/api/assist/batch/review-decision")
  rstatus=$(echo "$result" | jq -r '.status')

  if [ "$rstatus" = "ready" ]; then
    echo "$result"
    exit 0
  fi

  sleep 2
  ELAPSED=$((ELAPSED + 2))
done

echo '{"status":"timeout"}'
exit 1
