#!/usr/bin/env bash
# Poll for batch decisions until user clicks "Start Research"
# Usage: ./scripts/assist-poll [timeout_seconds]

set -e

TIMEOUT=${1:-300}
ELAPSED=0

while [ $ELAPSED -lt $TIMEOUT ]; do
  response=$(curl -s "http://localhost:4000/api/assist/batch/decisions")
  status=$(echo "$response" | jq -r '.status')

  if [ "$status" = "ready" ]; then
    echo "$response"
    exit 0
  fi

  sleep 2
  ELAPSED=$((ELAPSED + 2))
done

echo '{"status":"timeout"}'
exit 1
